DJANGO_SECRET_KEY=change-me-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_SITE_URL=http://localhost:8000

# PayPal: use sandbox values during development and live values in production
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# DATABASE_URL=postgres://user:password@localhost:5432/livingword

TIME_ZONE=UTC

# Object storage — set USE_S3=True once bucket credentials are ready
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=   # set for Cloudflare R2, omit for AWS S3
# AWS_S3_CUSTOM_DOMAIN=

# Prod email (config/settings/prod.py)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Email verification — set ACCOUNT_EMAIL_VERIFICATION=mandatory to require confirmation
# Development can keep the console backend in config/settings/dev.py.
ACCOUNT_EMAIL_VERIFICATION=none
# Production email delivery (required for real verification messages)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Living Word Library <noreply@example.com>
SERVER_EMAIL=noreply@example.com
EMAIL_TIMEOUT=20
# The Django Sites record (SITE_ID=1) must match this public HTTPS domain.
SITE_DOMAIN=library.example.com
SITE_NAME=The Living Word Library
# Keep this aligned with SITE_DOMAIN and use HTTPS in production.
PUBLIC_SITE_URL=https://library.example.com
