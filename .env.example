# Local development defaults. For production use DEBUG=False and HTTPS.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_SITE_URL=http://localhost:8000

# Social publishing. Generate SOCIAL_TOKEN_ENCRYPTION_KEY with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Production OAuth callback base, e.g. https://library.example.com
SOCIAL_OAUTH_REDIRECT_BASE=http://localhost:8000
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_THREADS_CLIENT_ID=
SOCIAL_THREADS_CLIENT_SECRET=
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=

# PayPal: use sandbox values during development and live values in production
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# DATABASE_URL=postgres://user:password@localhost:5432/livingword

TIME_ZONE=UTC

# Object storage — set USE_S3=True once bucket credentials are ready
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=   # set for Cloudflare R2, omit for AWS S3
# AWS_S3_CUSTOM_DOMAIN=

# Email verification
# Development: use ACCOUNT_EMAIL_VERIFICATION=none; dev.py prints emails to the terminal.
# Production: change to mandatory and use config.settings.prod.
ACCOUNT_EMAIL_VERIFICATION=none

# SMTP delivery — all values below are required for real verification emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Living Word Library <noreply@example.com>
SERVER_EMAIL=noreply@example.com
EMAIL_TIMEOUT=20

# Django Sites / public verification-link configuration.
# SITE_ID=1 is configured in Django; this domain must be the deployed HTTPS host.
SITE_DOMAIN=library.example.com
SITE_NAME=The Living Word Library
PUBLIC_SITE_URL=https://library.example.com
